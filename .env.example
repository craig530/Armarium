# ── Armarium configuration ──────────────────────────────────────────────────
# Copy to .env and fill in the required values before running.

# ── Required ─────────────────────────────────────────────────────────────────

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-random-secret

# Admin account (created on first run if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# ── Optional ──────────────────────────────────────────────────────────────────

# Port the web UI is served on (default: 8080)
PORT=8080

# JWT session length in minutes (default: 10080 = 7 days)
# JWT_EXPIRE_MINUTES=10080

# TMDB API key — required for Films & TV metadata lookup (DVD, Blu-ray,
# digital films and TV series)
# Get a free key at: https://www.themoviedb.org/settings/api
# TMDB_API_KEY=

# Database URL — defaults to SQLite (no extra setup needed).
# To use PostgreSQL instead, see README.md.
# DATABASE_URL=sqlite+aiosqlite:///./data/armarium.db

# Extra CORS origins allowed to call the API directly (comma-separated).
# The frontend and backend share an origin via the nginx proxy, so this is
# not needed for the default Docker setup — only set it if you're calling
# the API from a different origin (e.g. a separate dev frontend).
# CORS_ORIGINS=
