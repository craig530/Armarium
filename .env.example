# ── Armarium configuration ──────────────────────────────────────────────────
# Copy this file to .env and fill in the values below before running
# `docker compose up -d`. Never commit your .env file — it's already
# excluded via .gitignore.

# ── Required ─────────────────────────────────────────────────────────────────

# Secret key used to sign login sessions (JWTs). Generate a random one with:
#   openssl rand -hex 32
# If left unset, a random secret is generated each time the container starts,
# which logs every user out whenever it restarts.
JWT_SECRET=replace-me-with-a-random-secret

# Admin account, created automatically on first run if no users exist yet.
# Change ADMIN_PASSWORD to something secure before starting Armarium.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# ── Optional ──────────────────────────────────────────────────────────────────

# Port on your host machine that the web UI is served on.
PORT=8080

# How long a login session stays valid, in minutes, before you need to log
# in again. Default: 10080 (7 days).
# JWT_EXPIRE_MINUTES=10080

# TMDB API key — required for Films & TV metadata lookup. Music (MusicBrainz)
# and Books (Open Library) work without it.
# Get a free key at: https://www.themoviedb.org/settings/api
# TMDB_API_KEY=your_tmdb_api_key_here

# IGDB credentials — required for Games metadata lookup (search and barcode).
# IGDB uses Twitch OAuth2: register a Twitch app at https://dev.twitch.tv/console
# and generate client credentials. Both values are needed.
# IGDB_CLIENT_ID=your_igdb_client_id_here
# IGDB_CLIENT_SECRET=your_igdb_client_secret_here

# Database connection string — defaults to a SQLite file in the persistent
# data volume (no extra setup needed). To use PostgreSQL instead, see the
# "Advanced: Using PostgreSQL" section in README.md.
# DATABASE_URL=sqlite+aiosqlite:///./data/armarium.db

# Extra origins allowed to call the API directly, comma-separated. The
# frontend and backend share an origin via the bundled reverse proxy, so this
# is not needed for the default setup — only set it if you're calling the API
# from a different origin (e.g. a separate dev frontend).
# CORS_ORIGINS=https://example.com,https://app.example.com

# The browser login session cookie is marked `Secure` (HTTPS-only) by
# default. Only set this to false if you're running Armarium over plain HTTP
# (e.g. an internal network without TLS) — without it, browsers won't send
# the cookie back and you won't be able to log in.
# COOKIE_SECURE=true
